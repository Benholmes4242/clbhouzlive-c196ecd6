# Clbhouz Environment Variables
# Copy this file to .env.local and fill in your values

# Performance Tuning
# Enable aggressive caching and query optimizations
# Default: false (see src/config/flags.ts)
VITE_PERF_TUNING=false

# Access Gate Version (v1 or v2)
# v1 = Current gate UI, v2 = Modern minimal gate UI
# Default: v1
VITE_ACCESS_GATE_VERSION=v1

# Phase 5: Feature flags removed
# Hub is now always enabled for all users
