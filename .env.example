# Clbhouz Environment Variables
# Copy this file to .env.local and fill in your values

# Feature Flags
# Enable My Clubhouse Hub (/hub/* routes)
# Default: false (disabled in production)
VITE_FEATURE_HUB=false

# Performance Tuning
# Enable aggressive caching and query optimizations
# Default: false (see src/config/flags.ts)
VITE_PERF_TUNING=false
