# Clbhouz Environment Variables
# Copy this file to .env.local and fill in your values.
#
# PUBLIC BUILD CONFIG ONLY. Anything placed in `.env` is COMMITTED and its
# values ship in the client bundle: the Supabase anon key and URL, the
# Turnstile SITE key, the PostHog project key, a Mapbox pk. token, and feature
# flags. NEVER put a secret in `.env` — no service role key, no API secret, no
# credential. Secrets belong in `.env.local`, which is gitignored (Vite loads
# it after `.env`, so local overrides win).

# Performance Tuning
# Enable aggressive caching and query optimizations
# Default: false (see src/config/flags.ts)
VITE_PERF_TUNING=false

# Access Gate Version (v1 or v2)
# v1 = Current gate UI, v2 = Modern minimal gate UI
# Default: v1
VITE_ACCESS_GATE_VERSION=v1

# Leaderboard Mock Users (Benjamin Holmes only)
# When true, injects 100 mock users into Benjamin Holmes' leaderboard for UI testing
# Default: true (for testing), set false for production
VITE_LEADERBOARD_MOCK_USERS_ENABLED=true

# Phase 5: Feature flags removed
# Hub is now always enabled for all users
